# 复制为 dashboard/.env.glance，chmod 600；不入库。
# Compose 插值读根 .env，Glance 容器读取本文件。

# 当前后端为 Emby（历史变量名 JELLYFIN_API_KEY 已统一为 EMBY_API_KEY）。
EMBY_API_KEY=

# UDM 本地 API Key；自签名 HTTPS 仅在 UniFi widget 中跳过验证。
UNIFI_API_KEY=

# Immich：Glance 首页「照片库统计」用（内网直连，避免绕 AdGuard + NPM）。
IMMICH_URL=http://192.168.10.5:6104
IMMICH_API_KEY=
