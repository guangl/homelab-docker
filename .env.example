# 复制为 .env 后填写真实值：cp .env.example .env && chmod 600 .env
# .env 已被 .gitignore 排除，不会提交；缺项时 docker compose 会直接报错而不是静默启动

# PostgreSQL / Immich 共用数据库密码（immich-server 与 postgres 必须一致）
# 注意：修改已初始化数据库的密码需先 ALTER USER postgres PASSWORD '...'
POSTGRES_PASSWORD=changeme

# AdGuard Home 登录凭据（Glance 的 dns-stats 面板拉取统计用）
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=changeme

# WAQI 空气质量 API token（https://aqicn.org/data-platform/token/，Glance 面板用）
WAQI_TOKEN=your-waqi-token

# Telegram 通知：watchtower 推送容器更新结果，TrendRadar 推送热榜
# 与 @BotFather 创建，chat_id 可用 @userinfobot 查询
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=000000000

# 工具层：Umami 会话签名密钥（openssl rand -hex 32），Grafana 管理员密码
UMAMI_APP_SECRET=changeme
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
