# 当前 NAS / Mac mini 编排共用的本地参数。复制为 .env，权限设为 600。
HOMELAB_ROOT=/volume1/docker/homelab
MEDIA_ROOT=/volume1/homes/guangluo/entertainments
NPM_ROOT=/Users/guang/Projects/homelab_npm
ML_ROOT=/Users/guang/immich-ml
# qb_direct_lan 的物理父接口；新主机必须按实际网卡修改。
QBIT_PARENT_INTERFACE=bond0
# 不要为已初始化数据库随意更换密码。
DB_PASSWORD=REPLACE_IMMICH_DATABASE_PASSWORD
IMMICH_MACHINE_LEARNING_URL=http://192.168.10.4:3003
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=REPLACE_ADGUARD_PASSWORD
WAQI_TOKEN=REPLACE_WAQI_TOKEN
APPRISE_PASSWORD=REPLACE_APPRISE_PASSWORD
WATCHTOWER_NOTIFICATION_URL=REPLACE_SHOUTRRR_NOTIFICATION_URL
TUNNEL_USER=REPLACE_TUNNEL_USER
TUNNEL_HOST=REPLACE_TUNNEL_HOST
