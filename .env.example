# 复制为根 .env，chmod 600。Compose 与 media/workflow 脚本只读取这里的真实值；不要提交。

# --- Emby / Glance ---
EMBY_API_KEY=REPLACE_EMBY_API_KEY

# --- Immich ---
IMMICH_VERSION=v3.3.5
IMMICH_DB_PASSWORD=REPLACE_IMMICH_DATABASE_PASSWORD
IMMICH_URL=http://192.168.10.5:6104
IMMICH_API_KEY=REPLACE_IMMICH_API_KEY

# --- AdGuard Home / 监控 ---
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=REPLACE_ADGUARD_PASSWORD
WAQI_TOKEN=REPLACE_WAQI_TOKEN
UNIFI_API_KEY=REPLACE_UNIFI_API_KEY

# --- Apprise / Watchtower ---
APPRISE_USER=nas-app
APPRISE_PASSWORD=REPLACE_APPRISE_PASSWORD
WATCHTOWER_NOTIFICATION_URL=REPLACE_SHOUTRRR_NOTIFICATION_URL

# --- 手机通知路由（notification/notify）---
NOTIFY_PORT=6300
NOTIFY_BIND=0.0.0.0
NOTIFY_FORCE=auto
NOTIFY_UDM_HOST=https://192.168.10.1
NOTIFY_UDM_API_KEY=REPLACE_UNIFI_DREAM_MACHINE_API_KEY
NOTIFY_PHONE_PATTERNS=REPLACE_PHONE_NAME_PATTERN
NOTIFY_PHONE_FALLBACK=
NOTIFY_PHONE_MACS=
NOTIFY_PHONE_IPS=
NOTIFY_EMAIL_TO=REPLACE_NOTIFICATION_EMAIL
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASS=REPLACE_SMTP_APP_PASSWORD
SMTP_FROM=REPLACE_SMTP_FROM
SMTP_SSL=1
SMTP_STARTTLS=0
TELEGRAM_BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_TELEGRAM_CHAT_ID

# --- DDNS / 公网隧道（腾讯云 DNSPod）---
DNSPOD_SECRET_ID=REPLACE_DNSPOD_SECRET_ID
DNSPOD_SECRET_KEY=REPLACE_DNSPOD_SECRET_KEY

# --- 元数据简介 AI 翻译（media/workflow/media-arrival-tools）---
# cron 每 2 分钟运行一次；每轮最多 2 项，本值为每日 DeepSeek 调用上限，0 表示当天暂停。
EMBY_TRANSLATION_DAILY_LIMIT=100
