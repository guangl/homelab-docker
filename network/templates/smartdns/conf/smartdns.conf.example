ca-file /etc/smartdns/ca-certificates.crt
# Primary resolver behind Mac mini AdGuard; no external DNS fallback through ISP.
server-name homelab-smartdns
bind 127.0.0.1:6053
bind-tcp 127.0.0.1:6053
cache-size 16384
cache-persist yes
cache-file /var/lib/smartdns/smartdns.cache
prefetch-domain yes
serve-expired yes
serve-expired-ttl 300
serve-expired-reply-ttl 3
dualstack-ip-selection no
speed-check-mode none
response-mode fastest-response
log-level warn
log-console yes
audit-enable no
proxy-server socks5://192.168.10.4:6153 -name surge
# 境外：FQDN + 固定连接 IP + 代理，SNI/HTTP Host 取自 URL，CA 走 /etc/smartdns/ca-certificates.crt
server-https https://cloudflare-dns.com/dns-query -host-ip 1.1.1.1 -proxy surge
server-https https://cloudflare-dns.com/dns-query -host-ip 1.0.0.1 -proxy surge
server-https https://dns.google/dns-query -host-ip 8.8.8.8 -proxy surge
# 国内：FQDN + 固定连接 IP，直连；仅由 domain-set:china 选中
server-https https://dns.alidns.com/dns-query -host-ip 223.5.5.5 -group domestic -exclude-default-group
server-https https://doh.pub/dns-query -host-ip 1.12.12.12 -group domestic -exclude-default-group
domain-set -name china -file /etc/smartdns/china-domains.txt
nameserver /domain-set:china/domestic
domain-rules /domain-set:china/ -speed-check-mode tcp:443 -response-mode first-ping
address /monitor.guangluo.top/192.168.10.4
address /monitor.guangluo.top/#6
address /mini.guangluo.top/192.168.10.4
address /mini.guangluo.top/#6
address /home.guangluo.top/192.168.10.4
address /home.guangluo.top/#6
address /download.guangluo.top/192.168.10.4
address /download.guangluo.top/#6
address /anime.guangluo.top/192.168.10.4
address /anime.guangluo.top/#6
address /movie.guangluo.top/192.168.10.4
address /movie.guangluo.top/#6
address /draw.guangluo.top/192.168.10.4
address /draw.guangluo.top/#6
address /top.guangluo.top/192.168.10.4
address /top.guangluo.top/#6
address /nginx.guangluo.top/192.168.10.4
address /nginx.guangluo.top/#6
address /nas.guangluo.top/192.168.10.4
address /nas.guangluo.top/#6
address /adguard.guangluo.top/192.168.10.4
address /adguard.guangluo.top/#6
address /read.guangluo.top/192.168.10.4
address /read.guangluo.top/#6
address /dsm.guangluo.top/192.168.10.5
address /dsm.guangluo.top/#6

# bootstrap-direct BEGIN: resolve proxy entrances without depending on the proxy
domain-rules /REPLACE_BOOTSTRAP_DOMAIN_1/ -nameserver domestic -no-cache -no-serve-expired -rr-ttl-max 60 -speed-check-mode none
domain-rules /REPLACE_BOOTSTRAP_DOMAIN_2/ -nameserver domestic -no-cache -no-serve-expired -rr-ttl-max 60 -speed-check-mode none
domain-rules /REPLACE_BOOTSTRAP_DOMAIN_3/ -nameserver domestic -no-cache -no-serve-expired -rr-ttl-max 60 -speed-check-mode none
# bootstrap-direct END
